# Camera Configuration
CAMERA_SOURCE=0
RTSP_URL=rtsp://username:password@192.168.1.100:554/stream1
CAMERA_FPS=15
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Hardware & Model Settings
DEVICE=cuda
USE_FP16=true
YOLO_DETECTOR_MODEL=yolov8s.pt
YOLO_POSE_MODEL=yolov8s-pose.pt

# Alert & Notification Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
WEBHOOK_URL=http://localhost:8000/api/v1/alerts/webhook

# Privacy Settings
BLUR_FACES=true
SAVE_EVENT_SNAPSHOT=true
RETENTION_DAYS=7

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
